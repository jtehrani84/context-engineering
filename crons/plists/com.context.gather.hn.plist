<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Label must match the filename (minus .plist) -->
    <key>Label</key>
    <string>com.context.gather.hn</string>

    <!-- The script to run. Hacker News via the free Algolia API: no key needed. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <!-- __SCRIPT_DIR__ is replaced by manage.sh install -->
        <string>__SCRIPT_DIR__/gather/hn-scan.py</string>
    </array>

    <!-- Schedule: 4:45 AM daily. launchd runs a missed job when the Mac wakes. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>45</integer>
    </dict>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- __HOME__ is replaced by manage.sh install -->
        <key>PATH</key>
        <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <!-- Logging -->
    <key>StandardOutPath</key>
    <string>/tmp/context-crons-hn-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/context-crons-hn-stderr.log</string>

    <key>WorkingDirectory</key>
    <string>__SCRIPT_DIR__</string>

    <!-- Don't keep running: one-shot -->
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
